{
  "name": "含彰",
  "description": "含彰签名主题：克制现代风，单一靛蓝强调，零渐变零花边，深色模式原生安全，参照头部科技号的排版密度",
  "colors": {
    "primary": "#1f2328",
    "accent": "#155BC2",
    "background": "#ffffff",
    "blockquote_bg": "transparent",
    "code_bg": "#f6f8fa",
    "hr_color": "#e5e7eb",
    "footnote_bg": "#ffffff"
  },
  "styles": {
    "wrapper": {
      "padding": "0px"
    },
    "h1": {
      "font_size": "22px",
      "font_weight": "700",
      "color": "#111111",
      "line_height": "1.4",
      "margin_top": "32px",
      "margin_bottom": "20px"
    },
    "h2": {
      "font_size": "21px",
      "font_weight": "700",
      "color": "#111111",
      "line_height": "1.4",
      "border_left": "4px solid #155BC2",
      "padding_left": "12px",
      "margin_top": "44px",
      "margin_bottom": "22px"
    },
    "h3": {
      "font_size": "18px",
      "font_weight": "700",
      "color": "#111111",
      "line_height": "1.45",
      "margin_top": "32px",
      "margin_bottom": "16px"
    },
    "p": {
      "font_size": "17px",
      "color": "#333333",
      "line_height": "1.85",
      "margin_top": "0",
      "margin_bottom": "24px",
      "letter_spacing": "0.5px",
      "text_align": "left"
    },
    "blockquote": {
      "border_left": "3px solid #c9cdd4",
      "padding": "2px 0 2px 14px",
      "margin_top": "24px",
      "margin_bottom": "24px",
      "font_size": "17px",
      "color": "#57606a",
      "line_height": "1.8"
    },
    "blockquote_p": {
      "font_size": "17px",
      "color": "#57606a",
      "line_height": "1.8",
      "margin_bottom": "0",
      "letter_spacing": "0.5px"
    },
    "strong": {
      "font_weight": "700",
      "color": "#155BC2"
    },
    "em": {
      "font_style": "italic",
      "color": "#333333"
    },
    "a": {
      "color": "#155BC2",
      "text_decoration": "none",
      "border_bottom": "1px solid rgba(21,91,194,0.35)"
    },
    "img": {
      "max_width": "100%",
      "border_radius": "4px",
      "display": "block"
    },
    "img_wrapper": {
      "margin_top": "24px",
      "margin_bottom": "24px"
    },
    "hr": {
      "margin_top": "36px",
      "margin_bottom": "36px",
      "height": "1px",
      "background": "#e5e7eb",
      "border": "none"
    },
    "code": {
      "background": "rgba(27,31,35,0.06)",
      "padding": "3px 6px",
      "border_radius": "4px",
      "font_size": "14px",
      "color": "#c7254e",
      "font_family": "'SF Mono', Consolas, Menlo, monospace"
    },
    "code_block": {
      "background": "#f6f8fa",
      "border_radius": "6px",
      "margin_top": "20px",
      "margin_bottom": "24px",
      "overflow": "hidden"
    },
    "code_header": {
      "display": "flex",
      "align_items": "center",
      "height": "34px",
      "padding": "0 12px",
      "background": "#eef1f4"
    },
    "pre": {
      "background": "#f6f8fa",
      "color": "#1f2328",
      "padding": "16px",
      "border_radius": "0",
      "overflow_x": "auto",
      "margin_top": "0",
      "margin_bottom": "0",
      "font_size": "14px",
      "line_height": "1.6",
      "white_space": "pre-wrap",
      "word_wrap": "break-word",
      "word_break": "break-all"
    },
    "pre_code": {
      "background": "none",
      "padding": "0",
      "color": "#1f2328",
      "font_size": "14px",
      "font_family": "'SF Mono', Consolas, Menlo, monospace"
    },
    "table": {
      "width": "100%",
      "border_collapse": "collapse",
      "margin_top": "20px",
      "margin_bottom": "24px",
      "font_size": "15px"
    },
    "th": {
      "background": "#f6f8fa",
      "padding": "9px 14px",
      "border": "1px solid #dfe3e8",
      "text_align": "left",
      "font_weight": "600",
      "color": "#1f2328"
    },
    "td": {
      "padding": "9px 14px",
      "border": "1px solid #dfe3e8",
      "color": "#333333"
    },
    "list_item_bullet": {
      "color": "#155BC2",
      "margin_right": "9px",
      "font_weight": "bold"
    },
    "ol_item_bullet": {
      "display": "inline-flex",
      "align_items": "center",
      "justify_content": "center",
      "width": "22px",
      "height": "22px",
      "min_width": "22px",
      "background": "rgba(21,91,194,0.08)",
      "color": "#155BC2",
      "border_radius": "50%",
      "font_size": "13px",
      "font_weight": "bold",
      "margin_right": "10px",
      "margin_top": "5px"
    },
    "list_item_text": {
      "font_size": "17px",
      "color": "#333333",
      "line_height": "1.85",
      "letter_spacing": "0.5px"
    },
    "list_wrapper": {
      "margin_top": "20px",
      "margin_bottom": "24px"
    },
    "list_item_row": {
      "display": "flex",
      "margin_bottom": "8px",
      "align_items": "flex-start"
    },
    "footnote_section": {
      "margin_top": "40px",
      "padding_top": "16px",
      "border_top": "1px solid #e5e7eb"
    },
    "footnote_title": {
      "font_size": "14px",
      "font_weight": "bold",
      "color": "#999999",
      "margin_bottom": "12px"
    },
    "footnote_item": {
      "font_size": "13px",
      "color": "#999999",
      "margin_bottom": "6px",
      "line_height": "1.7",
      "word_break": "break-all"
    },
    "footnote_sup": {
      "font_size": "12px",
      "color": "#155BC2",
      "vertical_align": "super",
      "margin_left": "2px"
    },
    "callout": {
      "background": "rgba(21,91,194,0.05)",
      "border_left": "3px solid #155BC2",
      "padding": "16px",
      "margin_top": "24px",
      "margin_bottom": "24px",
      "border_radius": "0 6px 6px 0"
    },
    "callout_title": {
      "font_weight": "700",
      "color": "#155BC2",
      "margin_bottom": "8px",
      "font_size": "16px"
    },
    "callout_content": {
      "font_size": "16px",
      "color": "#333333",
      "line_height": "1.8",
      "letter_spacing": "0.3px"
    },
    "h4": {
      "font_size": "17px",
      "font_weight": "700",
      "color": "#111111",
      "margin_top": "28px",
      "margin_bottom": "12px",
      "line_height": "1.4"
    },
    "h5": {
      "font_size": "16px",
      "font_weight": "700",
      "color": "#555555",
      "margin_top": "20px",
      "margin_bottom": "8px",
      "line_height": "1.4"
    },
    "h6": {
      "font_size": "15px",
      "font_weight": "700",
      "color": "#888888",
      "margin_top": "16px",
      "margin_bottom": "8px",
      "line_height": "1.4"
    }
  },
  "dark_mode": {
    "h1": {
      "color": "#e8eaed"
    },
    "h2": {
      "color": "#e8eaed"
    },
    "h3": {
      "color": "#e8eaed"
    },
    "h4": {
      "color": "#d8dadd"
    },
    "p": {
      "color": "#c8c8c8"
    },
    "strong": {
      "color": "#7fb0ff"
    },
    "em": {
      "color": "#b0b0b0"
    },
    "a": {
      "color": "#7fb0ff"
    },
    "list_item_text": {
      "color": "#c8c8c8"
    },
    "blockquote": {
      "color": "#9aa3ad"
    },
    "blockquote_p": {
      "color": "#9aa3ad"
    },
    "code": {
      "bgcolor": "rgba(110,118,129,0.35)",
      "color": "#ff7b93"
    },
    "code_block": {
      "bgcolor": "#161b22"
    },
    "code_header": {
      "bgcolor": "#0d1117"
    },
    "pre": {
      "bgcolor": "#161b22",
      "color": "#e6edf3"
    },
    "pre_code": {
      "color": "#e6edf3"
    },
    "th": {
      "bgcolor": "#1e1e1e",
      "color": "#c8c8c8"
    },
    "td": {
      "bgcolor": "transparent",
      "color": "#c0c0c0"
    },
    "callout": {
      "bgcolor": "rgba(21,91,194,0.18)"
    },
    "callout_title": {
      "color": "#7fb0ff"
    },
    "callout_content": {
      "color": "#c0c0c0"
    },
    "ol_item_bullet": {
      "bgcolor": "rgba(21,91,194,0.3)",
      "color": "#7fb0ff"
    },
    "footnote_item": {
      "color": "#888888"
    },
    "footnote_title": {
      "color": "#888888"
    }
  }
}
